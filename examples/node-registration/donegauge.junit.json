{
  "version": 1,
  "task": "Implement user registration",
  "criteria": [
    {
      "id": "duplicate-email",
      "description": "Duplicate email is rejected",
      "check": {
        "command": [
          "node",
          "--test",
          "--test-reporter=junit",
          "--test-reporter-destination={evidenceDir}/junit.xml",
          "--test-name-pattern=duplicate email",
          "registration.test.mjs"
        ],
        "kind": "junit",
        "junit": {
          "file": "{evidenceDir}/junit.xml",
          "tests": [
            {
              "name": "duplicate email is rejected",
              "className": "test"
            }
          ],
          "minExecuted": 1
        }
      }
    },
    {
      "id": "password-hash",
      "description": "Passwords use salted scrypt storage",
      "check": {
        "command": [
          "node",
          "--test",
          "--test-reporter=junit",
          "--test-reporter-destination={evidenceDir}/junit.xml",
          "--test-name-pattern=password is hashed",
          "registration.test.mjs"
        ],
        "kind": "junit",
        "junit": {
          "file": "{evidenceDir}/junit.xml",
          "tests": [
            {
              "name": "password is hashed with per-user salt",
              "className": "test"
            }
          ],
          "minExecuted": 1
        }
      }
    },
    {
      "id": "login",
      "description": "User can log in after registration",
      "check": {
        "command": [
          "node",
          "--test",
          "--test-reporter=junit",
          "--test-reporter-destination={evidenceDir}/junit.xml",
          "--test-name-pattern=login after",
          "registration.test.mjs"
        ],
        "kind": "junit",
        "junit": {
          "file": "{evidenceDir}/junit.xml",
          "tests": [
            {
              "name": "login after registration",
              "className": "test"
            }
          ],
          "minExecuted": 1
        }
      }
    }
  ]
}
