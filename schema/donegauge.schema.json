{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:donegauge:config:v1",
  "title": "DoneGauge acceptance configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task", "criteria"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "base": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^-\\s][^\\s]*$",
      "default": "HEAD"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "check": {
            "$ref": "#/definitions/check"
          }
        }
      }
    }
  },
  "definitions": {
    "check": {
      "oneOf": [
        {
          "$ref": "#/definitions/commandCheck"
        },
        {
          "$ref": "#/definitions/junitCheck"
        }
      ]
    },
    "commandCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 32768,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 30000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1048576,
          "default": 65536
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exitCode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "default": 0
            },
            "stdoutIncludes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "stderrIncludes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        },
        "kind": {
          "const": "command"
        }
      }
    },
    "junitCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "junit"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 32768,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 30000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1048576,
          "default": 65536
        },
        "kind": {
          "const": "junit"
        },
        "junit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "tests"],
          "properties": {
            "file": {
              "type": "string",
              "maxLength": 1000,
              "pattern": "^\\{evidenceDir\\}/(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000]+/)*[^/\\\\\\u0000]+\\.xml$"
            },
            "tests": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  },
                  "className": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            },
            "minExecuted": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50000,
              "default": 1
            }
          }
        }
      }
    }
  }
}
